# DevCloud Platform Configuration

APP_NAME="DevCloud Çalışma Alanı Yönetimi"
DEBUG=True
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
COOKIE_SECURE=False

# Storage & Database
DATABASE_URL=sqlite+aiosqlite:///./data/devcloud.db
STORAGE_ROOT=./data/workspaces

# Quotas assigned to newly registered users (admins can override per user)
DEFAULT_USER_CPU_QUOTA=1.0
DEFAULT_USER_MEMORY_MB_QUOTA=1024
DEFAULT_USER_DISK_MB_QUOTA=10240

# Offline download publishing (admin-only updates; requires network + Podman)
DOWNLOADS_ENABLED=True
DOWNLOAD_UPDATES_ENABLED=True
DOWNLOADS_ROOT=/srv/devcloud-downloads
DOWNLOAD_BUILD_ROOT=/var/lib/devcloud/download-builds
DOWNLOAD_TARGET_PYTHON_VERSION=3.12
# Initial value; it can also be changed from Admin > Offline Downloads.
DOWNLOAD_PUBLIC_BASE_URL=http://10.253.6.189
# Temporary compatibility option. Enabling it skips worker OTA signature checks.
WORKER_OTA_ALLOW_UNSIGNED=False

# Container Orchestrator
PODMAN_BIN=podman
USE_MOCK_PODMAN=False
PODMAN_RUN_TIMEOUT_SECONDS=30

# Optional all-in-one/worker fallback. Prefer the central Admin > Entegrasyonlar
# Workspace AI setting for Jupyter AI and Cline; enrolled workers fetch it automatically.
# Configure the same values in /etc/devcloud/worker.env in production. The
# shared token is made available to every Jupyter workspace on that worker.
# The gateway URL is the root URL; Claude Code appends /v1/messages.
# JUPYTER_AI_GATEWAY_URL=http://llm-gateway.internal.example:5003
# JUPYTER_AI_MODEL=qwen3.6-35b
# JUPYTER_AI_GATEWAY_TOKEN=replace-with-shared-gateway-token
# JUPYTER_AI_GATEWAY_MODEL_DISCOVERY=false
# JUPYTER_AI_MODEL_CATALOG_JSON=[]

# Port forwarding range
PORT_RANGE_START=10100
PORT_RANGE_END=12000

# LDAP/Active Directory is configured at runtime from the Admin panel.
# SECRET_KEY also encrypts the saved LDAP bind password; set a strong,
# persistent value before saving directory credentials.

# Initial Admin Account
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
