# DevCloud Platform Configuration

APP_NAME="DevCloud Workspace Manager"
DEBUG=True
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
COOKIE_SECURE=False

# Storage & Database
DATABASE_URL=sqlite+aiosqlite:///./data/devcloud.db
STORAGE_ROOT=./data/workspaces

# Quotas assigned to newly registered users (admins can override per user)
DEFAULT_USER_CPU_QUOTA=1.0
DEFAULT_USER_MEMORY_MB_QUOTA=1024
DEFAULT_USER_DISK_MB_QUOTA=10240

# Offline download publishing (admin-only updates; requires network + Podman)
DOWNLOADS_ENABLED=False
DOWNLOAD_UPDATES_ENABLED=False
DOWNLOADS_ROOT=/srv/devcloud-downloads
DOWNLOAD_BUILD_ROOT=/var/lib/devcloud/download-builds
DOWNLOAD_TARGET_PYTHON_VERSION=3.12

# Container Orchestrator
PODMAN_BIN=podman
USE_MOCK_PODMAN=False
PODMAN_RUN_TIMEOUT_SECONDS=30

# Port forwarding range
PORT_RANGE_START=10100
PORT_RANGE_END=12000

# Authentication: 'internal' or 'active_directory'
AUTH_PROVIDER=internal

# Initial Admin Account
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
