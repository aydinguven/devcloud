[Unit]
Description=DevCloud Outbound Worker Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{USER}}
WorkingDirectory={{PROJECT_DIR}}
ExecStart={{PROJECT_DIR}}/.venv/bin/python -m app.worker_agent
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/devcloud/worker.env
# The installer renders the service account's numeric uid. Do not use the
# systemd uid specifier here: in system units it is 0, not the User= uid.
Environment=XDG_RUNTIME_DIR=/run/user/{{UID}}
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:{{PROJECT_DIR}}/.venv/bin
ExecStartPre=+/usr/bin/install -d -o {{USER}} -g {{USER}} -m 0700 /run/user/{{UID}}
LimitNOFILE=65535
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
