[Unit]
Description=Apply a queued DevCloud release
After=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory={{PROJECT_DIR}}
EnvironmentFile=-/etc/devcloud/controller.env
EnvironmentFile=-/etc/devcloud/worker.env
ExecStart={{PROJECT_DIR}}/.venv/bin/python -m app.installer.queued_update
PrivateTmp=true
NoNewPrivileges=true
