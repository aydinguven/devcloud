[Unit]
Description=DevCloud Self-Hosted Workspace Platform
After=network.target

[Service]
Type=simple
User={{USER}}
WorkingDirectory={{PROJECT_DIR}}
ExecStart={{PROJECT_DIR}}/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2 --timeout-graceful-shutdown 1
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
Environment=STORAGE_ROOT=/var/lib/devcloud/workspaces

# Security & Decoupled Podman Process Management
LimitNOFILE=65535
TimeoutStopSec=3
KillMode=process

[Install]
WantedBy=multi-user.target
