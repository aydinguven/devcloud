[Unit]
Description=DevCloud Self-Hosted Workspace Platform
After=network.target

[Service]
Type=simple
User={{USER}}
WorkingDirectory={{PROJECT_DIR}}
# Agent tunnels live in-process; keep a single async master process until the
# tunnel registry is moved to an external broker.
ExecStart={{PROJECT_DIR}}/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1 --timeout-graceful-shutdown 10
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
Environment=STORAGE_ROOT=/var/lib/devcloud/workspaces
Environment=XDG_RUNTIME_DIR=/run/user/0
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Security & Decoupled Podman Process Management
LimitNOFILE=65535
TimeoutStopSec=3
KillMode=process

[Install]
WantedBy=multi-user.target
