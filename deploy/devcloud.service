[Unit]
Description=DevCloud Controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{USER}}
WorkingDirectory={{PROJECT_DIR}}
EnvironmentFile=-/etc/devcloud/controller.env
# Agent tunnels live in-process; keep one controller process until the
# tunnel registry is moved to an external broker.
ExecStart={{PROJECT_DIR}}/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1 --timeout-graceful-shutdown 10
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

LimitNOFILE=65535
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
