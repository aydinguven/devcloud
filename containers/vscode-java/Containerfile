# VS Code (Java 21 LTS Environment)
FROM docker.io/codercom/code-server:latest

USER root

# Install OpenJDK 21, Maven, and build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-21-jdk \
    maven \
    gradle \
    git \
    curl \
    wget \
    build-essential \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
ENV PATH="${JAVA_HOME}/bin:${PATH}"

USER coder
WORKDIR /home/coder/project

# Install Red Hat Java Language Support & Debugger for Java
RUN code-server --install-extension redhat.java || true
RUN code-server --install-extension vscjava.vscode-java-debug || true
RUN code-server --install-extension vscjava.vscode-maven || true

EXPOSE 8080

ENTRYPOINT ["/usr/bin/entrypoint.sh", "--bind-addr", "0.0.0.0:8080", "/home/coder/project"]
