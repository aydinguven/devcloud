# VS Code (Java 21 LTS Environment)
# Keep the VS Code runtime reproducible; Cline compatibility is sensitive to
# the extension-host version bundled by code-server.
FROM docker.io/codercom/code-server:4.137.0@sha256:57ac684d44deb6fa94317b3e8f3e128dd7fb897fffd95b4efcd16f56ce607971

ARG CLINE_VERSION=4.1.17
ARG CLINE_VSIX_SHA256=82875472744ded4a360e22c726bb6101962ecf0a178aa8efe84a5c7ea728d2f5

USER root

# Install OpenJDK 21, Maven, and build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-21-jdk \
    maven \
    gradle \
    git \
    curl \
    wget \
    build-essential \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
ENV PATH="${JAVA_HOME}/bin:${PATH}"

USER coder
WORKDIR /home/coder/project

# Install Red Hat Java Language Support & Debugger for Java
RUN code-server --install-extension redhat.java || true
RUN code-server --install-extension vscjava.vscode-java-debug || true
RUN code-server --install-extension vscjava.vscode-maven || true
RUN curl -fsSL \
        "https://open-vsx.org/api/saoudrizwan/claude-dev/${CLINE_VERSION}/file/saoudrizwan.claude-dev-${CLINE_VERSION}.vsix" \
        -o /tmp/cline.vsix \
    && echo "${CLINE_VSIX_SHA256}  /tmp/cline.vsix" | sha256sum -c - \
    && code-server --install-extension /tmp/cline.vsix \
    && code-server --list-extensions --show-versions | grep -Fx "saoudrizwan.claude-dev@${CLINE_VERSION}" \
    && rm -f /tmp/cline.vsix \
    && install -d -m 700 /home/coder/.local/share/code-server/User \
    && printf '%s\n' \
        '{"extensions.autoCheckUpdates":false,"extensions.autoUpdate":false,"chat.disableAIFeatures":true,"cline.rollout.bundleOverride":"legacy"}' \
        > /home/coder/.local/share/code-server/User/settings.json

EXPOSE 8080

ENTRYPOINT ["/usr/bin/entrypoint.sh", "--bind-addr", "0.0.0.0:8080", "--auth", "none", "/home/coder/project"]

