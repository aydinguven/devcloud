ARG PYTHON_IMAGE=registry.access.redhat.com/ubi10/python-312-minimal:latest
FROM ${PYTHON_IMAGE}

ARG DEVCLOUD_VERSION=0.0.0
LABEL org.opencontainers.image.title="DevCloud Worker" \
      org.opencontainers.image.description="DevCloud rootful Podman workspace worker" \
      org.opencontainers.image.version="${DEVCLOUD_VERSION}"

USER 0
WORKDIR /opt/devcloud

RUN microdnf install -y podman tar gzip && microdnf clean all

COPY requirements.txt /opt/devcloud/requirements.txt
RUN python -m pip install --no-cache-dir --disable-pip-version-check \
        -r /opt/devcloud/requirements.txt

COPY app /opt/devcloud/app
COPY deploy /opt/devcloud/deploy
RUN chmod 0755 /opt/devcloud/deploy/container/worker-entrypoint.sh

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    CONTAINER_HOST=unix:///run/podman/podman.sock \
    STORAGE_ROOT=/var/lib/devcloud/workspaces \
    HOME=/root

ENTRYPOINT ["/opt/devcloud/deploy/container/worker-entrypoint.sh"]
