# Jupyter Notebook / Lab (Python Environment)
FROM docker.io/jupyter/minimal-notebook:latest

USER root

# Install essential system build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    wget \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

USER ${NB_UID}
WORKDIR /home/jovyan/work

# Install common Python data science & scripting libraries
RUN pip install --no-cache-dir \
    numpy \
    pandas \
    matplotlib \
    requests \
    httpx \
    uv

EXPOSE 8888

CMD ["start-notebook.py", "--ServerApp.ip=0.0.0.0", "--ServerApp.port=8888", "--ServerApp.allow_origin='*'", "--ServerApp.token=''", "--ServerApp.password=''", "--ServerApp.disable_check_xsrf=True", "--ServerApp.root_dir=/home/jovyan/work"]

