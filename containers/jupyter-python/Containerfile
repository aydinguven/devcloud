# Jupyter Notebook / Lab (Python Environment)
FROM docker.io/jupyter/minimal-notebook:latest

USER root

# Install essential system build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    wget \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

USER ${NB_UID}
WORKDIR /home/jovyan/work

# Install the Node runtime required by Claude Code and its ACP adapter.
RUN mamba install --yes nodejs=22 \
    && mamba clean --all --force-pkgs-dirs --yes

# Install common Python data science libraries and Jupyter AI 3 with notebook
# magic commands. The metapackage includes the ACP client and persona manager.
RUN pip install --no-cache-dir \
    numpy \
    pandas \
    matplotlib \
    requests \
    httpx \
    uv \
    "jupyter-ai[magics]==3.1.3"

# Keep the bundled Claude ACP persona implementation and stable persona ID,
# changing only the name shown to DevCloud users.
COPY rename_claude_persona.py /tmp/rename_claude_persona.py
RUN python /tmp/rename_claude_persona.py \
    && rm /tmp/rename_claude_persona.py

# Pin the agent and adapter so connected and air-gapped image builds use the
# same known pair. Claude Code remains available in the terminal, but the ACP
# adapter uses its bundled compatible runtime unless an operator explicitly
# overrides CLAUDE_CODE_EXECUTABLE.
RUN npm install --global \
    @anthropic-ai/claude-code@2.1.251 \
    @agentclientprotocol/claude-agent-acp@0.70.0 \
    && npm cache clean --force

EXPOSE 8888

CMD ["start-notebook.py", "--ServerApp.ip=0.0.0.0", "--ServerApp.port=8888", "--ServerApp.allow_origin='*'", "--ServerApp.token=''", "--ServerApp.password=''", "--ServerApp.disable_check_xsrf=True", "--ServerApp.root_dir=/home/jovyan/work"]
