# VS Code with Kilo Code (Python 3 + uv + Node.js 22)
#
# Kilo Code's VSIX is platform specific: the Linux x64 build from Open VSX
# ships the native agent CLI as extension/bin/kilo, which the extension starts
# on Linux.
#
# No keys or internal host names are baked in. DevCloud writes
# ~/.config/kilo/kilo.jsonc with the owner's AI Factory key and the Admin
# catalog, skills and indexing settings every time the container starts.
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.13.1
FROM ${UV_IMAGE} AS uv

# Keep the VS Code runtime reproducible; extension compatibility is sensitive
# to the extension-host version bundled by code-server.
FROM docker.io/codercom/code-server:4.137.0@sha256:57ac684d44deb6fa94317b3e8f3e128dd7fb897fffd95b4efcd16f56ce607971

ARG KILO_CODE_VERSION=7.8.17
ARG KILO_CODE_VSIX_URL=https://open-vsx.org/api/kilocode/kilo-code/linux-x64/${KILO_CODE_VERSION}/file/kilocode.kilo-code-${KILO_CODE_VERSION}@linux-x64.vsix
# Required: SHA-256 of the Linux x64 VSIX above (see CONTAINERS.md "Updating
# Kilo Code"). The build refuses to run without it, so an
# unverified extension can never reach a published image.
ARG KILO_CODE_VSIX_SHA256=b438caf4be0c148050af1849db28c043b779ac89f38793c35d61e509211183c4

LABEL org.opencontainers.image.title="DevCloud Kilo Code workspace"

USER root

# Python and Node.js toolchains, plus ripgrep for the agent's code search
# (otherwise it tries to download one at runtime, which fails offline).
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    curl \
    git \
    gnupg \
    python3 \
    python3-dev \
    python3-pip \
    python3-venv \
    ripgrep \
    unzip \
    wget \
    && curl -fsSL https://deb.nodesource.com/setup_22.x -o /tmp/nodesource_setup.sh \
    && bash /tmp/nodesource_setup.sh \
    && rm -f /tmp/nodesource_setup.sh \
    && apt-get install -y --no-install-recommends nodejs \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /uvx /usr/local/bin/

# LanceDB native runtime for codebase indexing, pinned by its lockfile. Kilo
# Code loads it from KILO_LANCEDB_PATH instead of bundling it.
COPY lancedb/package.json lancedb/package-lock.json /opt/kilo/lancedb/
RUN npm ci --prefix /opt/kilo/lancedb --omit=dev --ignore-scripts --no-audit --no-fund \
    && node -e 'require(process.argv[1])' \
        /opt/kilo/lancedb/node_modules/@lancedb/lancedb/dist/index.js \
    && chmod -R a+rX /opt/kilo

# Local stdio MCP server (kilo-install) that writes catalog items into the
# open project's .kilo folder. DevCloud's kilo.jsonc starts it with bash.
COPY LocalMCP.sh /opt/kilo/LocalMCP.sh
RUN chmod 0755 /opt/kilo/LocalMCP.sh && bash -n /opt/kilo/LocalMCP.sh

ENV KILO_LANCEDB_PATH=/opt/kilo/lancedb/node_modules/@lancedb/lancedb/dist/index.js \
    KILO_TELEMETRY_LEVEL=off \
    KILO_DISABLE_AUTOUPDATE=1 \
    KILO_DISABLE_MODELS_FETCH=1 \
    KILO_DISABLE_SHARE=1 \
    KILO_DISABLE_SESSION_INGEST=1 \
    KILO_DISABLE_LSP_DOWNLOAD=1

USER coder
WORKDIR /home/coder/project

# code-server keeps the zip modes of a VSIX, so the execute bit is restored on
# the bundled native tools (kilo, bwrap, ffmpeg, kilo-sandbox-seccomp) in case
# a release stores them without it; otherwise the agent cannot start.
RUN test -n "${KILO_CODE_VSIX_SHA256}" \
        || { echo "Set KILO_CODE_VSIX_SHA256 to pin the Linux x64 Kilo Code VSIX." >&2; exit 1; } \
    && curl -fsSL "${KILO_CODE_VSIX_URL}" -o /tmp/kilocode.vsix \
    && echo "${KILO_CODE_VSIX_SHA256}  /tmp/kilocode.vsix" | sha256sum -c - \
    && code-server --install-extension /tmp/kilocode.vsix \
    && code-server --list-extensions --show-versions | grep -Fx "kilocode.kilo-code@${KILO_CODE_VERSION}" \
    && rm -f /tmp/kilocode.vsix \
    && ext="$(ls -d /home/coder/.local/share/code-server/extensions/kilocode.kilo-code-${KILO_CODE_VERSION}*)" \
    && find "${ext}/bin" -maxdepth 1 -type f ! -name '*.js' -exec chmod 0755 {} + \
    && cli="${ext}/bin/kilo" \
    && test -x "${cli}" \
    && "${cli}" --version \
    && install -d -m 700 /home/coder/.local/share/code-server/User \
    && printf '%s\n' \
        '{"extensions.autoCheckUpdates":false,"extensions.autoUpdate":false,"chat.disableAIFeatures":true}' \
        > /home/coder/.local/share/code-server/User/settings.json

EXPOSE 8080

ENTRYPOINT ["/usr/bin/entrypoint.sh", "--bind-addr", "0.0.0.0:8080", "--auth", "none", "/home/coder/project"]
