ARG PYTHON_IMAGE=registry.access.redhat.com/ubi10/python-312-minimal:latest
FROM ${PYTHON_IMAGE}

ARG DEVCLOUD_VERSION=0.0.0
LABEL org.opencontainers.image.title="DevCloud Controller" \
      org.opencontainers.image.description="DevCloud management plane and worker tunnel controller" \
      org.opencontainers.image.version="${DEVCLOUD_VERSION}"

USER 0
WORKDIR /opt/devcloud

COPY requirements.txt /opt/devcloud/requirements.txt
RUN python -m pip install --no-cache-dir --disable-pip-version-check \
        -r /opt/devcloud/requirements.txt

COPY app /opt/devcloud/app
COPY deploy /opt/devcloud/deploy
RUN chmod 0755 /opt/devcloud/deploy/container/controller-entrypoint.sh

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/tmp

EXPOSE 8000
USER 10001:10001
ENTRYPOINT ["/opt/devcloud/deploy/container/controller-entrypoint.sh"]

